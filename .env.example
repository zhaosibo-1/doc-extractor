# ---------------------------------------------------------------------------
# 环境变量样例。复制成 .env 后填写 —— .env 已被 gitignore，绝不会进仓库。
# ---------------------------------------------------------------------------

# 什么都不配也能跑：抽取会走纯规则引擎（engine=rule），结果完全可复现。
# 配上 Key 之后，规则没抽到的字段会交给模型补漏（置信度上限 0.6）。

# ---- 文本大模型（OpenAI 兼容协议）----
# 预设名，可选：deepseek / moonshot / zhipu / qwen / openai / siliconflow / custom
LLM_PRESET=deepseek
# 真实 Key 只放这里，不要写进代码或模板
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 留空则用预设自带的地址；换自建网关时填
LLM_BASE_URL=
# 留空则用预设自带的模型名
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ---- 视觉大模型（图片 / 扫描件）----
# 图片与扫描件没有文字层，只有视觉模型能读。留空则图片抽取会被明确跳过
# 并在结果里给出 warnings，而不是返回一份空结果让用户猜。
VISION_MODEL=

# ---- 抽取引擎 ----
# auto = 规则优先、模型补漏（推荐）｜ rule = 只用规则｜ llm = 主要交给模型
EXTRACT_ENGINE=auto

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_MB=10
DATA_DIR=data

# ---- 解析限制（防止超大文件拖垮服务）----
# 超出上限的内容会被**截断并明确告知**，绝不静默丢弃
PDF_MAX_PAGES=60
TABLE_MAX_ROWS=500
BLOCK_MAX_COUNT=4000
HEADER_MAX_ROWS=3

# ---- 存储 ----
# false 时上传的文件只留在内存里（测试环境用，避免仓库留下残留）
STORE_PERSIST=true
